# Pré-seleção do provedor no prompt interativo (opcional).
# Se omitido, os scripts perguntam no início e aceitam "openai" como default.
# Valores aceitos: openai | gemini
PROVIDER=openai

OPENAI_API_KEY=
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

GOOGLE_API_KEY=
GOOGLE_EMBEDDING_MODEL=gemini-embedding-2-preview

DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/rag
PG_VECTOR_COLLECTION_NAME=documents

PDF_PATH=./document.pdf
